# Backend-only settings. Do not put provider credentials in frontend variables.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional dataset folder or archive. Defaults to the project's data/raw folder.
THERMOEXPLAIN_DATASET_PATH=
# GPT-OSS is the sole supported language-model provider.
LLM_PROVIDER=gpt_oss
# Backend-only credentials; never put these values in frontend variables.
GPT_OSS_API_KEY=
GPT_OSS_MODEL=openai/gpt-oss-120b
# Optional API-compatible endpoint override. By default, the Groq SDK uses its official API endpoint.
GPT_OSS_BASE_URL=
# Optional legacy aliases for GPT-OSS settings; GPT_OSS_* values take precedence.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
# Optional local thermal-knowledge corpus and generated search index.
THERMOEXPLAIN_KNOWLEDGE_PATH=
THERMOEXPLAIN_KNOWLEDGE_INDEX_PATH=
# BERT remains unconfigured until both paths point to a fine-tuned local model
# and a separate held-out JSONL test set with the model's verified labels.
THERMOEXPLAIN_BERT_MODEL_PATH=
THERMOEXPLAIN_BERT_TEST_DATA_PATH=
